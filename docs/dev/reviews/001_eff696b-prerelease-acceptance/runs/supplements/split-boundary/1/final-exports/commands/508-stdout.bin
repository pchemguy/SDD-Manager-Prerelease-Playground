+class PublicFileApiTests(unittest.TestCase):
+    def test_file_signature_and_keyword_only_policy(self):
+        signature = inspect.signature(count_file)
+        self.assertEqual(list(signature.parameters), ['path', 'strip_bom'])
+        self.assertEqual(signature.parameters['path'].kind,
+                         inspect.Parameter.POSITIONAL_OR_KEYWORD)
+        self.assertEqual(signature.parameters['strip_bom'].kind,
+                         inspect.Parameter.KEYWORD_ONLY)
+        self.assertIs(signature.parameters['strip_bom'].default, True)
+        self.assertEqual(signature.parameters['path'].annotation, str | PathLike[str])
+        self.assertIs(signature.parameters['strip_bom'].annotation, bool)
+        self.assertIs(signature.return_annotation, TextStats)
+        with self.assertRaises(TypeError):
+            count_file('sample', False)
+
+    def test_real_file_spec_matrix_matches_text_and_preserves_bytes_silently(self):
+        cases = (('', (0, 0)), ('alpha beta', (1, 2)), ('alpha\n', (1, 1)),
+                 ('\n', (1, 0)), ('alpha\r\nbeta\rgamma\n', (3, 3)),
+                 ('alpha\n\n', (2, 1)), (' \t', (1, 0)),
+                 ('alpha\u2028beta', (1, 2)), ('\ufeff', (0, 0)),
+                 ('\ufeff\ufeff', (1, 1)), ('\ufeffalpha beta', (1, 2)),
+                 ('a\ufeffb', (1, 1)), ('\r\n', (1, 0)), ('\r', (1, 0)),
+                 ('你好\t café\nnaïve', (2, 3)))
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'sample.txt'
+            for text, expected in cases:
+                original = text.encode('utf-8')
+                path.write_bytes(original)
+                for value in (str(path), path):
+                    for policy in (True, False):
+                        result = (1, 1) if text == '\ufeff' and not policy else expected
+                        with self.subTest(text=text, path_type=type(value), policy=policy):
+                            stdout, stderr = io.StringIO(), io.StringIO()
+                            with contextlib.redirect_stdout(stdout), contextlib.redirect_stderr(stderr):
+                                actual = count_file(value, strip_bom=policy)
+                            self.assertEqual(actual, TextStats(*result))
+                            self.assertEqual(actual, count_text(text, strip_bom=policy))
+                            self.assertEqual(path.read_bytes(), original)
+                            self.assertEqual((stdout.getvalue(), stderr.getvalue()), ('', ''))
+
+    def test_real_missing_file_and_invalid_bytes_preserve_exception_and_input(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'sample.txt'
+            stdout, stderr = io.StringIO(), io.StringIO()
+            with contextlib.redirect_stdout(stdout), contextlib.redirect_stderr(stderr):
+                with self.assertRaises(FileNotFoundError):
+                    count_file(path)
+                original = b'valid prefix\xff'
+                path.write_bytes(original)
+                with self.assertRaises(UnicodeDecodeError):
+                    count_file(path)
+            self.assertEqual(path.read_bytes(), original)
+            self.assertEqual((stdout.getvalue(), stderr.getvalue()), ('', ''))
+
+
 if __name__ == '__main__':
     unittest.main()
diff --git a/tests/unit/test_io.py b/tests/unit/test_io.py
new file mode 100644
index 0000000..a744727
--- /dev/null
+++ b/tests/unit/test_io.py
@@ -0,0 +1,82 @@
+"""Strict UTF-8 acquisition and owned-handle lifetime under SPEC R-006."""
+
+import contextlib
+import io
+import unittest
+from unittest.mock import patch
+
+from textstats import TextStats, count_file
+
+
+class FailingRead(io.BytesIO):
+    """Expose valid partial bytes, then fail instead of delivering a result."""
+
+    error = BlockingIOError('controlled read failure')
+
+    def read(self, *args):
+        super().read(1)
+        raise self.error
+
+
+class FileAcquisitionTests(unittest.TestCase):
+    def test_success_closes_owned_handle_without_newline_translation(self):
+        stream = io.BytesIO('α\r\nβ\rγ\n'.encode('utf-8'))
+        with patch('textstats.io.open', return_value=stream, create=True) as opener:
+            self.assertEqual(count_file('sample'), TextStats(3, 3))
+        self.assertTrue(stream.closed)
+        opener.assert_called_once_with('sample', 'rb')
+
+    def test_bom_policy_preserves_repeated_and_interior_boms(self):
+        for data, default, retained in ((b'\xef\xbb\xbf', (0, 0), (1, 1)),
+                                       ('\ufeff\ufeff'.encode(), (1, 1), (1, 1)),
+                                       ('a\n\ufeff'.encode(), (2, 2), (2, 2))):
+            for policy, expected in ((True, default), (False, retained)):
+                with self.subTest(data=data, policy=policy):
+                    stream = io.BytesIO(data)
+                    with patch('textstats.io.open', return_value=stream, create=True):
+                        self.assertEqual(count_file('sample', strip_bom=policy),
+                                         TextStats(*expected))
+                    self.assertTrue(stream.closed)
+
+    def test_open_oserror_subclasses_propagate_unchanged_and_silently(self):
+        for error in (FileNotFoundError('missing'), PermissionError('denied'),
+                      IsADirectoryError('directory')):
+            with self.subTest(error=error):
+                stdout, stderr = io.StringIO(), io.StringIO()
+                with patch('textstats.io.open', side_effect=error, create=True), \
+                        contextlib.redirect_stdout(stdout), contextlib.redirect_stderr(stderr):
+                    with self.assertRaises(type(error)) as caught:
+                        count_file('sample')
+                self.assertIs(caught.exception, error)
+                self.assertEqual((stdout.getvalue(), stderr.getvalue()), ('', ''))
+
+    def test_read_failure_closes_and_propagates_without_counting_partial_input(self):
+        stream = FailingRead(b'valid partial input')
+        stdout, stderr = io.StringIO(), io.StringIO()
+        with patch('textstats.io.open', return_value=stream, create=True), \
+                patch('textstats.io.count_text', create=True) as counter, \
+                contextlib.redirect_stdout(stdout), contextlib.redirect_stderr(stderr):
+            with self.assertRaises(BlockingIOError) as caught:
+                count_file('sample')
+            self.assertIs(caught.exception, stream.error)
+            counter.assert_not_called()
+        self.assertTrue(stream.closed)
+        self.assertEqual((stdout.getvalue(), stderr.getvalue()), ('', ''))
+
+    def test_strict_decode_failure_closes_without_counting_partial_input(self):
+        for invalid in (b'valid text\xff', b'\xef\xbb\xbfvalid\xc3', b'\xc0\xaf'):
+            with self.subTest(invalid=invalid):
+                stream = io.BytesIO(invalid)
+                stdout, stderr = io.StringIO(), io.StringIO()
+                with patch('textstats.io.open', return_value=stream, create=True), \
+                        patch('textstats.io.count_text', create=True) as counter, \
+                        contextlib.redirect_stdout(stdout), contextlib.redirect_stderr(stderr):
+                    with self.assertRaises(UnicodeDecodeError):
+                        count_file('sample')
+                    counter.assert_not_called()
+                self.assertTrue(stream.closed)
+                self.assertEqual((stdout.getvalue(), stderr.getvalue()), ('', ''))
+
+
+if __name__ == '__main__':
+    unittest.main()
