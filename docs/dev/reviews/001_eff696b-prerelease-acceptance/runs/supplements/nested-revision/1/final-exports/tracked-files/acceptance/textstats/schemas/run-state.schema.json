{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "phase": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3",
        "P4",
        "P5"
      ]
    },
    "case_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^A-0(0[1-9]|1[0-9]|2[0-7])$"
        }
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "role": {
      "enum": [
        "coordinator",
        "consumer",
        "assessor"
      ]
    },
    "last_completed_action": {
      "type": "string"
    },
    "pending_operation": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "task",
                "commit",
                "push",
                "merge",
                "api",
                "checkpoint"
              ]
            },
            "status": {
              "enum": [
                "in_progress",
                "uncertain",
                "blocked",
                "interrupted"
              ]
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "identity": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "branch": {
                  "type": "string",
                  "minLength": 1
                },
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "task_id": {
                  "type": "string",
                  "minLength": 1
                },
                "issue_number": {
                  "type": "integer",
                  "minimum": 1
                },
                "endpoint": {
                  "type": "string",
                  "minLength": 1
                },
                "operation_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": []
            }
          },
          "required": [
            "kind",
            "status",
            "description"
          ]
        }
      ]
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "checkpoint_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_branch": {
          "type": "string",
          "minLength": 1
        },
        "evidence_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "product_branch": {
          "type": "string",
          "minLength": 1
        },
        "product_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "integration_branch": {
          "type": "string",
          "minLength": 1
        },
        "integration_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "remote": {
          "type": "string",
          "minLength": 1
        },
        "remote_ref": {
          "type": "string",
          "minLength": 1
        },
        "remote_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "merge_parents": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "bundle_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "local_only_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": []
    },
    "evidence_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "plugin_source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_mode": {
          "enum": [
            "committed",
            "dirty"
          ]
        },
        "package_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "propertyNames": {
            "type": "string",
            "minLength": 1
          }
        },
        "manifest_path": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_path": {
          "type": "string",
          "minLength": 1
        },
        "dirty_diff_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "commit",
        "source_mode",
        "package_hashes"
      ]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "local_checkout": {
          "type": "string",
          "minLength": 1
        },
        "remote": {
          "type": "string",
          "minLength": 1
        },
        "remote_url": {
          "type": "string",
          "minLength": 1
        },
        "integration_branch": {
          "type": "string",
          "minLength": 1
        },
        "campaign_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "identity"
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "git_publication": {
          "type": "boolean"
        },
        "github_api": {
          "type": "boolean"
        },
        "fresh_consumers": {
          "type": "boolean"
        },
        "independent_assessor": {
          "type": "boolean"
        },
        "interruption_control": {
          "type": "boolean"
        },
        "installed_client": {
          "type": "boolean"
        },
        "recovery_exports": {
          "type": "boolean"
        },
        "protected_credentials": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": []
    },
    "case_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^A-0(0[1-9]|1[0-9]|2[0-7])$"
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "Pending",
              "Running",
              "Passed",
              "Failed",
              "Blocked",
              "Not run"
            ]
          },
          "assisted": {
            "type": "boolean"
          },
          "first_attempt_status": {
            "enum": [
              "Pending",
              "Running",
              "Passed",
              "Failed",
              "Blocked",
              "Not run"
            ]
          },
          "assessment_path": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "case_id",
          "attempt",
          "status"
        ]
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "variant": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Current variant name for new split-case attempts; absent remains a historical unsplit case."
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "phase",
    "case_id",
    "attempt",
    "role",
    "last_completed_action",
    "pending_operation",
    "next_action",
    "checkpoint_refs",
    "evidence_paths"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-manager.invalid/acceptance/textstats/run-state.schema.json",
  "title": "TextStats coordinator checkpoint, version 1",
  "description": "Non-secret coordinator cursor; reconcile actual files/index/Git/provider effects on resume. Not product transaction authority. Credential values/paths are forbidden."
}
