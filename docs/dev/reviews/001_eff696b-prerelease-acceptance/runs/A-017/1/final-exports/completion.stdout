 class CliTests(unittest.TestCase):
+    def test_input_failures_identify_input_and_cause_without_output(self):
+        failures = [FileNotFoundError('missing file'), PermissionError('permission denied'), OSError('read failed'), UnicodeDecodeError('utf-8', b'\xff', 0, 1, 'invalid byte')]
+        for failure in failures:
+            with self.subTest(failure=failure):
+                out, err = io.StringIO(), io.StringIO()
+                with patch('textstats.cli.count_file', side_effect=failure):
+                    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+                        status = main(['named'])
+                self.assertEqual((status, out.getvalue()), (1, ''))
+                self.assertIn('named', err.getvalue())
+                self.assertIn(str(failure), err.getvalue())
+                self.assertNotIn('Traceback', err.getvalue())
+
+    def test_usage_failures_validate_before_acquisition(self):
+        for args in [[], ['one', 'two'], ['--unknown', 'named'], ['--keep', 'named'], ['--keep-b', 'named']]:
+            with self.subTest(args=args):
+                out, err = io.StringIO(), io.StringIO()
+                with patch('textstats.cli.count_file') as counter:
+                    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+                        status = main(args)
+                self.assertEqual((status, out.getvalue()), (2, ''))
+                self.assertIn('usage:', err.getvalue())
+                self.assertIn('error:', err.getvalue())
+                self.assertNotIn('Traceback', err.getvalue())
+                counter.assert_not_called()
+
     def test_success_renders_completed_counts(self):
         out, err = io.StringIO(), io.StringIO()
         with patch('textstats.cli.count_file', return_value=TextStats(3, 4)) as counter:
