diff --git a/tests/integration/test_api.py b/tests/integration/test_api.py
new file mode 100644
index 0000000..4db902d
--- /dev/null
+++ b/tests/integration/test_api.py
@@ -0,0 +1,101 @@
+"""Verify direct silent whole-input text and named-file adapters."""
+
+import contextlib
+import importlib
+import inspect
+import io
+import subprocess
+import sys
+import unittest
+import tempfile
+from pathlib import Path
+
+import textstats
+from textstats import TextStats, count_text, count_file
+
+
+class TextApiTests(unittest.TestCase):
+    def test_direct_imports_and_delivered_exports(self):
+        self.assertIs(textstats.TextStats, TextStats)
+        self.assertIs(textstats.count_text, count_text)
+        self.assertEqual(set(textstats.__all__), {"TextStats", "count_text", "count_file"})
+        self.assertIs(textstats.count_file, count_file)
+
+    def test_signatures_and_keyword_only_policy(self):
+        stats_parameters = inspect.signature(TextStats).parameters
+        self.assertEqual(list(stats_parameters), ["lines", "words"])
+        self.assertTrue(all(p.default is inspect.Parameter.empty for p in stats_parameters.values()))
+        signature = inspect.signature(count_text)
+        self.assertEqual(list(signature.parameters), ["text", "strip_bom"])
+        self.assertIs(signature.parameters["strip_bom"].kind, inspect.Parameter.KEYWORD_ONLY)
+        self.assertIs(signature.parameters["strip_bom"].default, True)
+        annotations = inspect.get_annotations(count_text, eval_str=True)
+        self.assertEqual(annotations, {"text": str, "strip_bom": bool, "return": TextStats})
+        with self.assertRaises(TypeError):
+            count_text("abc", False)
+
+    def test_public_default_and_retaining_policy(self):
+        self.assertEqual(count_text("\ufeff"), TextStats(0, 0))
+        self.assertEqual(count_text("\ufeff", strip_bom=False), TextStats(1, 1))
+        self.assertEqual(count_text("α\r\n猫\rβ γ\n"), TextStats(3, 4))
+
+    def test_calls_and_reload_are_silent(self):
+        stdout, stderr = io.StringIO(), io.StringIO()
+        with contextlib.redirect_stdout(stdout), contextlib.redirect_stderr(stderr):
+            importlib.reload(textstats)
+            for value in ["", "\ufeff", "a\r\nb", "a\u2029b"]:
+                count_text(value)
+                count_text(value, strip_bom=False)
+            TextStats(0, 0)
+        self.assertEqual(stdout.getvalue(), "")
+        self.assertEqual(stderr.getvalue(), "")
+
+    def test_initial_import_is_silent_in_fresh_process(self):
+        result = subprocess.run([sys.executable, "-B", "-c", "import textstats"], capture_output=True, text=True)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(result.stdout, "")
+        self.assertEqual(result.stderr, "")
+
+
+class FileApiTests(unittest.TestCase):
+    def test_file_text_matrix_and_preservation(self):
+        cases = ["", "alpha beta", "alpha\n", "\n", "alpha\r\nbeta\rgamma\n", "alpha\n\n", " \t", "alpha\u2028beta", "\ufeff", "\ufeff\ufeff", "\ufeffalpha beta", "a\ufeffb", "\r\n", "\r", "α 猫\n"]
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "sample.txt"
+            for text in cases:
+                raw = text.encode("utf-8")
+                path.write_bytes(raw)
+                for argument in [path, str(path)]:
+                    for policy in [True, False]:
+                        with self.subTest(text=text, argument=type(argument), strip_bom=policy):
+                            out, err = io.StringIO(), io.StringIO()
+                            with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+                                actual = count_file(argument, strip_bom=policy)
+                            self.assertEqual(actual, count_text(text, strip_bom=policy))
+                            self.assertEqual((out.getvalue(), err.getvalue()), ("", ""))
+                            self.assertEqual(path.read_bytes(), raw)
+
+    def test_decode_failure_and_missing_path_propagate_silently(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "bad"
+            path.write_bytes(b"valid prefix\n\xff")
+            out, err = io.StringIO(), io.StringIO()
+            with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+                with self.assertRaises(UnicodeDecodeError):
+                    count_file(path)
+                with self.assertRaises(FileNotFoundError):
+                    count_file(path.with_name("absent"))
+            self.assertEqual((out.getvalue(), err.getvalue()), ("", ""))
+            self.assertEqual(path.read_bytes(), b"valid prefix\n\xff")
+
+    def test_file_signature(self):
+        parameters = inspect.signature(count_file).parameters
+        self.assertEqual(list(parameters), ["path", "strip_bom"])
+        self.assertIs(parameters["strip_bom"].kind, inspect.Parameter.KEYWORD_ONLY)
+        self.assertIs(parameters["strip_bom"].default, True)
+        with self.assertRaises(TypeError):
+            count_file("unused", False)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/integration/test_cli.py b/tests/integration/test_cli.py
new file mode 100644
index 0000000..55939e6
--- /dev/null
+++ b/tests/integration/test_cli.py
@@ -0,0 +1,79 @@
+"""Real module-entry named-file checks with exact process streams and bytes."""
+
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+from textstats import TextStats, count_file
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+class ModuleCliTests(unittest.TestCase):
+    def invoke(self, *args, cwd=ROOT):
+        return subprocess.run([sys.executable, "-B", '-m', 'textstats', *args], cwd=cwd, env={**os.environ, 'PYTHONPATH': str(ROOT)}, capture_output=True, text=True)
+
+    def test_named_file_matrix_and_bom_option_order(self):
+        cases = [('', (0, 0), (0, 0)), ('α\r\n猫\rβ γ\n', (3, 4), (3, 4)), ('\ufeff', (0, 0), (1, 1)), ('\ufeff\ufeff', (1, 1), (1, 1)), ('alpha\u2028beta', (1, 2), (1, 2)), ('a\n\n', (2, 1), (2, 1))]
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'sample.txt'
+            for text, default, retained in cases:
+                raw = text.encode('utf-8')
+                path.write_bytes(raw)
+                for args, policy, expected in [( [str(path)], True, default), (['--keep-bom', str(path)], False, retained), ([str(path), '--keep-bom'], False, retained)]:
+                    with self.subTest(text=text, args=args):
+                        result = self.invoke(*args)
+                        self.assertEqual((result.returncode, result.stdout, result.stderr), (0, f'lines={expected[0]} words={expected[1]}\n', ''))
+                        self.assertEqual(count_file(path, strip_bom=policy), TextStats(*expected))
+                        self.assertEqual(path.read_bytes(), raw)
+
+    def test_help_without_input(self):
+        for option in ['-h', '--help']:
+            result = self.invoke(option)
+            self.assertEqual(result.returncode, 0, result.stderr)
+            self.assertEqual(result.stderr, '')
+            self.assertIn('usage:', result.stdout)
+            self.assertIn('--keep-bom', result.stdout)
+            self.assertIn('INPUT', result.stdout)
+
+    def test_dash_filenames_and_double_dash_termination(self):
+        with tempfile.TemporaryDirectory() as directory:
+            for name in ['-sample', '--keep-bom', '-']:
+                path = Path(directory) / name
+                path.write_bytes(b'alpha beta\n')
+                result = self.invoke('--', name, cwd=directory)
+                self.assertEqual((result.returncode, result.stdout, result.stderr), (0, 'lines=1 words=2\n', ''))
+                self.assertEqual(path.read_bytes(), b'alpha beta\n')
+
+    def test_exactly_one_input_is_required(self):
+        for args in [[], ['one', 'two']]:
+            result = self.invoke(*args)
+            self.assertEqual(result.returncode, 2)
+            self.assertEqual(result.stdout, '')
+            self.assertIn('usage:', result.stderr)
+
+    def test_missing_and_invalid_utf8_are_clean_input_failures(self):
+        with tempfile.TemporaryDirectory() as directory:
+            missing = Path(directory) / 'absent.txt'
+            bad = Path(directory) / 'bad.txt'
+            bad.write_bytes(b'valid prefix\n\xff')
+            for path, cause in [(missing, 'No such file'), (bad, 'utf-8')]:
+                for options in [[], ['--keep-bom']]:
+                    with self.subTest(path=path, options=options):
+                        result = self.invoke(*options, str(path))
+                        self.assertEqual((result.returncode, result.stdout), (1, ''))
+                        self.assertIn(str(path), result.stderr)
+                        self.assertIn(cause, result.stderr)
+                        self.assertNotIn('Traceback', result.stderr)
+            self.assertEqual(bad.read_bytes(), b'valid prefix\n\xff')
+
+    def test_unknown_option_is_usage_even_with_missing_input(self):
+        for option in ['--unknown', '--keep']:
+            with self.subTest(option=option):
+                result = self.invoke(option, 'nonexistent.txt')
+                self.assertEqual((result.returncode, result.stdout), (2, ''))
+                self.assertIn('usage:', result.stderr)
+                self.assertNotIn('Traceback', result.stderr)
diff --git a/tests/integration/test_distribution.py b/tests/integration/test_distribution.py
new file mode 100644
index 0000000..52a7219
--- /dev/null
+++ b/tests/integration/test_distribution.py
@@ -0,0 +1,66 @@
+"""Source allowlist and real isolated extracted-module acceptance contracts."""
+
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+import zipfile
+from pathlib import Path
+
+from tools.package_source import build_archive
+from tools.check_distribution import verify_archive
+
+ROOT = Path(__file__).resolve().parents[2]
+APPROVED = {'README.md', 'docs/public-api.md', 'AI_DISCLOSURE.md', 'SDD-MANAGER.md',
+            'textstats/__init__.py', 'textstats/__main__.py', 'textstats/core.py',
+            'textstats/io.py', 'textstats/cli.py', 'tools/package_source.py',
+            'tools/check_distribution.py'}
+
+
+class DistributionTests(unittest.TestCase):
+    def test_archive_exact_allowlist_excludes_unrelated_material(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory) / 'source'
+            for name in APPROVED:
+                target = root / name
+                target.parent.mkdir(parents=True, exist_ok=True)
+                target.write_bytes((ROOT / name).read_bytes())
+            for name in ['gh.tkn', 'textstats/__pycache__/cache.pyc', 'textstats/extra.py',
+                         'textstats-run-resources/fake.txt', '.github/workflows/foreign.yml',
+                         'tests/workflows/fake.py', 'docs/dev/fake.md', 'dist/old.zip']:
+                path = root / name
+                path.parent.mkdir(parents=True, exist_ok=True)
+                path.write_text('unmanaged fixture, never a real credential')
+            archive = build_archive(root, Path(directory) / 'source.zip')
+            with zipfile.ZipFile(archive) as bundle:
+                self.assertEqual(set(bundle.namelist()), {'textstats-source/' + n for n in APPROVED})
+                for name in APPROVED:
+                    self.assertEqual(bundle.read('textstats-source/' + name), (ROOT / name).read_bytes())
+
+    def test_checker_verifies_real_extracted_module_with_polluted_import_environment(self):
+        with tempfile.TemporaryDirectory() as directory:
+            archive = build_archive(ROOT, Path(directory) / 'source.zip')
+            from unittest.mock import patch
+            with patch.dict(os.environ, {'PYTHONPATH': str(ROOT)}):
+                self.assertGreaterEqual(verify_archive(archive), 10)
+
+    def test_checker_rejects_wrong_extracted_cli_even_when_checkout_is_healthy(self):
+        with tempfile.TemporaryDirectory() as directory:
+            archive = build_archive(ROOT, Path(directory) / 'source.zip')
+            faulty = Path(directory) / 'faulty.zip'
+            with zipfile.ZipFile(archive) as source, zipfile.ZipFile(faulty, 'w') as target:
+                for name in source.namelist():
+                    data = source.read(name)
+                    if name == 'textstats-source/textstats/cli.py':
+                        data = b'"""Controlled faulty extraction."""\ndef main(argv=None):\n    print("lines=999 words=999")\n    return 0\n'
+                    target.writestr(name, data)
+            with self.assertRaises((AssertionError, RuntimeError)):
+                verify_archive(faulty)
+
+    def test_documented_checker_script_builds_and_runs(self):
+        result = subprocess.run([sys.executable, "-B", str(ROOT / 'tools/check_distribution.py')], cwd=ROOT,
+                                capture_output=True, text=True)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertIn('extracted import:', result.stdout)
+        self.assertIn('module cases passed', result.stdout)
